      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize Range"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可视化范围"
          }
        }
      }
    },
    "Dims the picture outside this color's range. It is not kept when you press OK.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dims the picture outside this color's range. It is not kept when you press OK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此颜色范围以外的图像调暗。按“确定”后不会保留该显示效果。"
          }
        }
      }
    },
    "Grading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分级"
          }
        }
      }
    },
    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“三向”同时显示阴影、中间调和高光；其他选项只显示一个色轮。"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
