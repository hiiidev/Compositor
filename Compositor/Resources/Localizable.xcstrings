    "error.subjectRemoval.noSubject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No foreground subject was detected in this layer. Try an image with a more distinct subject."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在此图层中检测到前景主体。请尝试主体更清晰的图像。"
          }
        }
      }
    },
    "error.contentFill.noSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough unselected, opaque image pixels to synthesize a fill. Use a smaller selection with some surrounding image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选中的不透明图像像素不足，无法合成填充。请缩小选区，并保留一些周围图像。"
          }
        }
      }
    },
