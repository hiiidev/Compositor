    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL lists every color. Color edits one family. Point Color adjusts a color you pick."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL 显示所有颜色；“颜色”编辑一个色系；“点颜色”调整你选取的颜色。"
          }
        }
      }
    },
    "Component": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Component"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分量"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue shifts the color, Saturation its strength, and Luminance its brightness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改变颜色，饱和度改变颜色强度，明亮度改变亮度。"
          }
        }
      }
    },
    "Drag a color in the picture. Nearby color families move together.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a color in the picture. Nearby color families move together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像中的颜色上拖动；相邻色系会一起调整。"
          }
        }
      }
    },
    "Click the picture to save a color. Up to eight colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the picture to save a color. Up to eight colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图像保存一个颜色，最多可保存八个。"
          }
        }
      }
    },
    "Select this picked color.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this picked color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此取样颜色。"
          }
        }
      }
    },
