    "error.import.unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be read. It may be damaged or unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取图像。文件可能已损坏或不可用。"
          }
        }
      }
    },
    "error.import.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a JPEG, PNG, HEIC, or TIFF image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 JPEG、PNG、HEIC 或 TIFF 图像。"
          }
        }
      }
    },
    "error.import.tooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This import exceeds the current 100-megapixel document budget or 30,000-pixel side limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此导入超出当前 1 亿像素的文档预算或 30,000 像素单边限制。"
          }
        }
      }
    },
    "error.export.tooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image export supports canvases up to 100 megapixels and 30,000 pixels per side."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像导出支持的画布上限为 1 亿像素，且单边不超过 30,000 像素。"
          }
        }
      }
    },
    "error.export.render": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas could not be rendered. Try a smaller canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法渲染画布。请尝试使用较小的画布。"
          }
        }
      }
    },
    "error.export.encode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be encoded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法编码图像。"
          }
        }
      }
    },
    "error.project.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid Compositor project, or its metadata is damaged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是有效的 Compositor 项目，或者项目元数据已损坏。"
          }
        }
      }
    },
    "error.project.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project uses format version %d. This app supports versions 1–8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目使用格式版本 %d。本应用支持版本 1–8。"
          }
        }
      }
    },
    "error.project.missingImage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An image inside the project is missing or damaged. The current document has not been replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目中的某个图像缺失或已损坏。当前文档未被替换。"
          }
        }
      }
    },
    "error.project.tooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project exceeds the supported canvas, layer, file-size, or 100-megapixel image limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目超出支持的画布、图层、文件大小或 1 亿像素图像限制。"
          }
        }
      }
    },
    "error.project.encode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An image could not be saved. The previous project has not been replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存某个图像。原有项目未被替换。"
          }
        }
      }
    },
    "error.wand.tooDetailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该选区过于复杂，无法生成轮廓。请尝试调整“容差”，或开启“连续”。"
          }
        }
      }
    },
    "error.wand.memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn’t enough memory to make that selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存不足，无法创建该选区。"
          }
        }
      }
    },
    "error.objectSelection.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Object Selection requires macOS 14 or later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对象选择需要 macOS 14 或更高版本。"
