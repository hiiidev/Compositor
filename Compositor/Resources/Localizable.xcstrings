    "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画笔会以此长度跟随指针，从而让抖动的手势也能绘制平滑线条"
          }
        }
      }
    },
    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametric lifts tonal regions. Point places anchors on the curve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“参数”用于调整各色调区域；“点”可在曲线上放置控制点。"
          }
        }
      }
    },
    "RGB changes brightness. Red, green, and blue also shift the color.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB changes brightness. Red, green, and blue also shift the color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 调整明暗；红、绿、蓝通道还会改变颜色。"
          }
        }
      }
    },
